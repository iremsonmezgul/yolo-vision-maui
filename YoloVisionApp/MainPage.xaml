<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YoloVisionApp.Controls"
             x:Class="YoloVisionApp.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">
        <controls:CameraFrameView
            x:Name="FrameView"
            Grid.Row="0" />

        <Label
            x:Name="StatsLabel"
            Grid.Row="0"
            Margin="12"
            Padding="8,4"
            BackgroundColor="#80000000"
            TextColor="White"
            FontSize="13"
            HorizontalOptions="Start"
            VerticalOptions="Start" />

        <Label
            x:Name="ErrorLabel"
            Grid.Row="0"
            Margin="24"
            TextColor="OrangeRed"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="False" />

        <Button
            x:Name="ToggleButton"
            Grid.Row="1"
            Margin="12"
            Text="Durdur"
            Clicked="OnToggleClicked" />
    </Grid>

</ContentPage>
